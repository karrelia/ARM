# АРМ Теплооблік — красиві URL /api/... для PHP-бекенда на Apache.
# Потрібно, щоб у конфізі Apache для цієї теки було  AllowOverride All
# і ввімкнено mod_rewrite (sudo a2enmod rewrite && sudo systemctl restart apache2).
#
# Якщо mod_rewrite недоступний — нічого страшного: клієнт сам перейде на
# прямі URL /api.php/... , які працюють без переписування.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # тека даних (ключ API у config.json, персональні дані, фото, бекапи) —
  # тільки через /api; (^|/) накриває і вкладені теки backup/ та photos/
  RewriteRule (^|/)arm-data/ - [F,L]
  # /api/ping  ->  api.php  (PATH_INFO = /ping)
  RewriteRule ^api/(.*)$ api.php/$1 [L,QSA]
  RewriteRule ^api$      api.php    [L,QSA]
</IfModule>

# Друга (незалежна) лінія оборони теки даних: mod_alias вкомпільований у
# більшість збірок Apache, тож правило спрацює навіть без mod_rewrite.
<IfModule mod_alias.c>
  RedirectMatch 403 /arm-data/
</IfModule>

# Правильний MIME для файлів PWA. Критично для ВСТАНОВЛЮВАНОСТІ: якщо sw.js
# віддається не як JavaScript (напр. text/plain), браузер відхиляє реєстрацію
# service worker — і Chrome пропонує лише «ярлик» замість «Встановити застосунок».
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType application/json .json
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  # UTF-8 для текстових ресурсів (щоб кирилиця в JS/HTML не «ламалась»)
  AddCharset utf-8 .js .mjs .css .json .webmanifest .html
</IfModule>

# Service worker має бути з максимальною областю дії — не кешувати сам sw.js надовго
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>

# Захист теки з даними від прямого доступу через веб (на випадок, якщо
# mod_rewrite вимкнено — блокуємо й за іменем файлу)
# Третя лінія: заборона за ІМЕНЕМ файлу — діє в будь-якій теці й не залежить
# ані від mod_rewrite, ані від mod_alias. Шаблон навмисно ширший за «db.json»:
# треба накрити ще й бекапи (db-2026-09-03.json) та тимчасові файли
# атомарного запису (db.json.tmp, users.json.tmp) — саме їх пропускала
# попередня версія правила.
<IfModule mod_authz_core.c>
  <FilesMatch "^(db|users|config)[-.]">
    Require all denied
  </FilesMatch>
</IfModule>
