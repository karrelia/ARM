// Завантаження показників із застосунку «Теплооблік» у 1С.
//
// Файл — «Повний список» з блоку «Для 1С» на «Огляді» застосунку.
// 1. «Прочитати й перевірити»: кожен рядок зіставляється з 1С (особовий,
//    прилад, попередній показник, уже створені документи). Що не знайдено —
//    червоним зі словами, що саме виправити; попередження — помаранчевим.
// 2. Виправляєте в 1С (або в застосунку) → «Перевірити ще раз».
// 3. «Створити документи»: лише позначені рядки. Метод 1С визначає документ:
//      Акт      — Акт зняття показань теплолічильника (один на особовий, усі його прилади)
//      Опалення — Ввід показань приладів (опалення)   (один на особовий)
//      Ввід     — Ввід показань приладів обліку        (один на особовий)
//      Акт+Ввід — обидва

#Область ПодіїФорми

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Проводити = Истина;
	ДатаПоказань = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	НалаштуватиОформлення();
КонецПроцедуры

&НаКлиенте
Процедура ФайлЕксельНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.ПолноеИмяФайла = ФайлЕксель;
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Оберіть файл «Повний список» із застосунку";
	Если Диалог.Выбрать() Тогда
		ФайлЕксель = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛишеПроблемніПриИзменении(Элемент)
	ЗастосуватиВідбір();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПоказаньПриИзменении(Элемент)
	ДатаПоказань = НачалоМесяца(ДатаПоказань);
КонецПроцедуры

#КонецОбласти

#Область Команди

&НаКлиенте
Процедура ПрочитатиІПеревірити(Команда)
	Если НЕ ЗначениеЗаполнено(ФайлЕксель) Тогда
		Предупреждение("Вкажіть файл «Повний список» із застосунку (Огляд → Для 1С → Повний список).");
		Возврат;
	КонецЕсли;
	Рядки = ПрочитатиФайлКлієнт(ФайлЕксель);
	Если Рядки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Помилка = ЗавантажитиРядкиНаСервері(Рядки);
	Если ЗначениеЗаполнено(Помилка) Тогда
		Предупреждение(Помилка);
		Возврат;
	КонецЕсли;
	ЗастосуватиВідбір();
КонецПроцедуры

&НаКлиенте
Процедура ПеревіритиЩеРаз(Команда)
	Если Данные.Количество() = 0 Тогда
		Предупреждение("Спершу прочитайте файл.");
		Возврат;
	КонецЕсли;
	ПеревіритиНаСервері();
	ЗастосуватиВідбір();
КонецПроцедуры

&НаКлиенте
Процедура СтворитиДокументи(Команда)
	Кількість = 0;
	Для Каждого Р Из Данные Цикл
		Если Р.Пометка Тогда
			Кількість = Кількість + 1;
		КонецЕсли;
	КонецЦикла;
	Если Кількість = 0 Тогда
		Предупреждение("Немає позначених рядків.");
		Возврат;
	КонецЕсли;
	Текст = "Створити документи за " + Формат(ДатаПоказань, "ДФ='MMMM yyyy'") + " для " + Кількість + " позначених рядків?"
		+ ?(Проводити, "", Символы.ПС + "(без проведення — лише записати)");
	Если Вопрос(Текст, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	СтворитиДокументиНаСервері();
	ЗастосуватиВідбір();
	Предупреждение(Підсумок);
КонецПроцедуры

&НаКлиенте
Процедура ПозначитиВсіБезПомилок(Команда)
	Для Каждого Р Из Данные Цикл
		Р.Пометка = Р.ЄПоказник И НЕ Р.Помилка И НЕ ЗначениеЗаполнено(Р.Документ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗнятиПозначки(Команда)
	Для Каждого Р Из Данные Цикл
		Р.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ЧитанняФайлу

// Читає перший аркуш Excel у масив рядків (кожен — масив рядкових значень).
&НаКлиенте
Функция ПрочитатиФайлКлієнт(Шлях)
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Возврат ПрочитатиФайлЧерезСервер(Шлях);
	КонецПопытки;
	Результат = Новый Массив;
	Попытка
		Excel.DisplayAlerts = Ложь;
		Книга = Excel.Workbooks.Open(Шлях, 0, Истина);
		Лист = Книга.Worksheets(1);
		Рядків = Лист.UsedRange.Rows.Count;
		Колонок = Лист.UsedRange.Columns.Count;
		Для Н = 1 По Рядків Цикл
			Рядок = Новый Массив;
			Порожній = Истина;
			Для К = 1 По Колонок Цикл
				З = ТекстКомірки(Лист.Cells(Н, К).Value);
				Рядок.Добавить(З);
				Если НЕ ПустаяСтрока(З) Тогда
					Порожній = Ложь;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Порожній Тогда
				Результат.Добавить(Рядок);
			КонецЕсли;
		КонецЦикла;
		Книга.Close(Ложь);
		Excel.Quit();
	Исключение
		Опис = ОписаниеОшибки();
		Попытка Excel.Quit(); Исключение КонецПопытки;
		Предупреждение("Помилка читання файлу: " + Опис);
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Без Excel на комп'ютері: файл читає 1С (табличний документ) на сервері.
&НаКлиенте
Функция ПрочитатиФайлЧерезСервер(Шлях)
	Адрес = "";
	Попытка
		ПоместитьФайл(Адрес, Шлях, , Ложь, УникальныйИдентификатор);
	Исключение
		Предупреждение("Не вдалося відкрити файл: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Результат = ПрочитатиНаСервері(Адрес);
	Если Результат = Неопределено Тогда
		Предупреждение("Не вдалося прочитати файл: на комп'ютері немає Excel, а 1С не змогла відкрити .xlsx.");
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатиНаСервері(Адрес)
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	Попытка
		ПолучитьИзВременногоХранилища(Адрес).Записать(ИмяФайла);
		ТД = Новый ТабличныйДокумент;
		ТД.Прочитать(ИмяФайла);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Результат = Новый Массив;
	Для Н = 1 По ТД.ВысотаТаблицы Цикл
		Рядок = Новый Массив;
		Порожній = Истина;
		Для К = 1 По ТД.ШиринаТаблицы Цикл
			З = СокрЛП(ТД.Область(Н, К, Н, К).Текст);
			Рядок.Добавить(З);
			Если НЕ ПустаяСтрока(З) Тогда
				Порожній = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Порожній Тогда
			Результат.Добавить(Рядок);
		КонецЕсли;
	КонецЦикла;
	Попытка УдалитьФайлы(ИмяФайла); Исключение КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТекстКомірки(Значення)
	Если Значення = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значення) = Тип("Число") Тогда
		Возврат Формат(Значення, "ЧРД=.; ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значення) = Тип("Дата") Тогда
		Возврат Формат(Значення, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значення));
КонецФункции

#КонецОбласти

#Область ЗавантаженняТаПеревірка

&НаСервере
Функция ЗавантажитиРядкиНаСервері(Рядки)
	Данные.Очистить();
	// рядок заголовка: той, де є «Особовий»
	НомерЗаголовка = -1;
	Для Н = 0 По Мин(Рядки.Количество() - 1, 9) Цикл
		Для Каждого З Из Рядки[Н] Цикл
			Если СтрНайти(НРег(З), "особов") > 0 Тогда
				НомерЗаголовка = Н;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НомерЗаголовка >= 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НомерЗаголовка < 0 Тогда
		Возврат "У файлі немає колонки «Особовий рахунок». Потрібен «Повний список» із застосунку (Огляд → Для 1С).";
	КонецЕсли;
	К = КолонкиЗаголовка(Рядки[НомерЗаголовка]);
	Если К.Особовий < 0 ИЛИ К.Показник < 0 ИЛИ К.Метод < 0 Тогда
		Возврат "У файлі немає колонок «Особовий рахунок», «Показник» або «Метод 1С». Потрібен «Повний список» із застосунку.";
	КонецЕсли;

	Місяці = Новый Соответствие;
	Для Н = НомерЗаголовка + 1 По Рядки.Количество() - 1 Цикл
		Р = Рядки[Н];
		Особовий = Комірка(Р, К.Особовий);
		Номер = Комірка(Р, К.Номер);
		ПоказникТекст = Комірка(Р, К.Показник);
		Если ПустаяСтрока(Особовий) И ПустаяСтрока(Номер) Тогда
			Продолжить;
		КонецЕсли;
		НС = Данные.Добавить();
		НС.НомерУФайлі = Н + 1;
		НС.Особовий = Особовий;
		НС.НомерЛічильника = Номер;
		НС.Метод = Комірка(Р, К.Метод);
		НС.ЄПоказник = НЕ ПустаяСтрока(ПоказникТекст);
		НС.Показник = ЧислоЗРядка(ПоказникТекст);
		НС.ДатаЗняття = ДатаЗРядка(Комірка(Р, К.Дата));
		НС.Хто = Комірка(Р, К.Хто);
		НС.Адреса = Комірка(Р, К.Адреса);
		// додаткові параметри приладу — лише заповнені (ключ=значення;)
		Дод = "";
		Для Каждого КЗ Из К.Дод Цикл
			Т = Комірка(Р, КЗ.Значение);
			Если НЕ ПустаяСтрока(Т) Тогда
				Дод = Дод + КЗ.Ключ + "=" + Формат(ЧислоЗРядка(Т), "ЧРД=.; ЧН=0; ЧГ=0") + ";";
			КонецЕсли;
		КонецЦикла;
		НС.Дод = Дод;
		Если НС.ЄПоказник И ЗначениеЗаполнено(НС.ДатаЗняття) Тогда
			КлючМ = НачалоМесяца(НС.ДатаЗняття);
			Місяці.Вставить(КлючМ, ?(Місяці[КлючМ] = Неопределено, 0, Місяці[КлючМ]) + 1);
		КонецЕсли;
	КонецЦикла;
	// звітний місяць — той, у якому найбільше показань
	Макс = 0;
	Для Каждого КЗ Из Місяці Цикл
		Если КЗ.Значение > Макс Тогда
			Макс = КЗ.Значение;
			ДатаПоказань = КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	ПеревіритиНаСервері();
	Возврат "";
КонецФункции

&НаСервере
Функция КолонкиЗаголовка(Заголовок)
	К = Новый Структура("Особовий,Номер,Показник,Метод,Дата,Хто,Адреса", -1, -1, -1, -1, -1, -1, -1);
	Дод = Новый Соответствие;
	Для Н = 0 По Заголовок.Количество() - 1 Цикл
		З = НРег(СокрЛП(Заголовок[Н]));
		Если СтрНайти(З, "особов") > 0 Тогда
			К.Особовий = Н;
		ИначеЕсли СтрНайти(З, "водомір") > 0 Тогда
			Дод.Вставить(?(СтрНайти(З, "попер") > 0, "ВодомірП", "Водомір"), Н);
		ИначеЕсли СтрНайти(З, "вода") > 0 Тогда
			Дод.Вставить(?(СтрНайти(З, "попер") > 0, "ВодаП", "Вода"), Н);
		ИначеЕсли СтрНайти(З, "наробіт") > 0 Тогда
			Дод.Вставить(?(СтрНайти(З, "попер") > 0, "НаробітокП", "Наробіток"), Н);
		ИначеЕсли СтрНайти(З, "простій") > 0 Тогда
			Дод.Вставить(?(СтрНайти(З, "попер") > 0, "ПростійП", "Простій"), Н);
		ИначеЕсли СтрНайти(З, "температура") > 0 Тогда
			Дод.Вставить(?(СтрНайти(З, "вих") > 0, "ТВихід", "ТВхід"), Н);
		ИначеЕсли СтрНайти(З, "витрат") > 0 Тогда
			Дод.Вставить("Витрата", Н);
		ИначеЕсли СтрНайти(З, "потужн") > 0 Тогда
			Дод.Вставить("Потужність", Н);
		ИначеЕсли СтрНайти(З, "лічильник") > 0 ИЛИ СтрНайти(З, "прилад") > 0 Тогда
			Если К.Номер < 0 Тогда
				К.Номер = Н;
			КонецЕсли;
		ИначеЕсли СтрНайти(З, "метод") > 0 Тогда
			К.Метод = Н;
		ИначеЕсли СтрНайти(З, "попередн") > 0 Тогда
			// «Попередній показник» із застосунку — довідково, береться з 1С
		ИначеЕсли СтрНайти(З, "показник") = 1 Тогда
			К.Показник = Н;
		ИначеЕсли СтрНайти(З, "дата") > 0 Тогда
			К.Дата = Н;
		ИначеЕсли СтрНайти(З, "хто") > 0 Тогда
			К.Хто = Н;
		ИначеЕсли СтрНайти(З, "адрес") > 0 Тогда
			К.Адреса = Н;
		КонецЕсли;
	КонецЦикла;
	К.Вставить("Дод", Дод);
	Возврат К;
КонецФункции

&НаСервере
Процедура ПеревіритиНаСервері()
	Початок = НачалоМесяца(ДатаПоказань);
	Кінець = КонецМесяца(ДатаПоказань);
	КешЛС = Новый Соответствие;
	Бачені = Новый Соответствие;     // ключ приладу → № рядка у файлі (повтори)
	Для Каждого Р Из Данные Цикл
		Если ЗначениеЗаполнено(Р.Документ) Тогда
			Р.Пометка = Ложь;   // уже створено цією обробкою
			Продолжить;
		КонецЕсли;
		Р.Помилка = Ложь;
		Р.Попередження = Ложь;
		Р.ЛицевойСчет = Справочники.ЛицевыеСчета.ПустаяСсылка();
		Р.ПриборУчета = Справочники.ПриборыУчета.ПустаяСсылка();
		Р.Попередній1С = 0;
		Р.ДатаПопер1С = '00010101';
		Р.Різниця = 0;
		Статуси = Новый Массив;

		Метод = НормМетод(Р.Метод);
		Если НЕ Р.ЄПоказник Тогда
			Р.Статус = "Немає показника за місяць — пропущено";
			Р.Пометка = Ложь;
			Продолжить;
		КонецЕсли;
		Если Метод = "" Тогда
			Р.Помилка = Истина;
			Статуси.Добавить(?(ПустаяСтрока(Р.Метод), "Не вказано метод 1С — задайте в застосунку (картка приладу або перелік)",
				"Невідомий метод «" + Р.Метод + "»"));
		КонецЕсли;

		// --- особовий ---
		КлючЛС = НормНомер(Р.Особовий);
		ЛС = КешЛС[КлючЛС];
		Если ЛС = Неопределено Тогда
			ЛС = ЗнайтиОсобовий(Р.Особовий);
			КешЛС.Вставить(КлючЛС, ЛС);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ЛС) Тогда
			Р.Помилка = Истина;
			Статуси.Добавить(?(ПустаяСтрока(Р.Особовий), "У файлі немає особового — впишіть його в застосунку",
				"Не знайдено особовий «" + Р.Особовий + "» (немає або не діє)"));
		Иначе
			Р.ЛицевойСчет = ЛС;
		КонецЕсли;

		// --- прилад ---
		Прилад = ЗнайтиПрилад(Р.НомерЛічильника, ЛС, Кінець);
		Если ЗначениеЗаполнено(Прилад.Прилад) Тогда
			Р.ПриборУчета = Прилад.Прилад;
		КонецЕсли;
		Если ЗначениеЗаполнено(Прилад.Помилка) Тогда
			Р.Помилка = Истина;
			Статуси.Добавить(Прилад.Помилка);
		ИначеЕсли ЗначениеЗаполнено(Прилад.Попередження) Тогда
			Р.Попередження = Истина;
			Статуси.Добавить(Прилад.Попередження);
		КонецЕсли;

		// --- попередній показник: ОСТАННІЙ ВВЕДЕНИЙ у 1С (з обох регістрів) і різниця ---
		Если ЗначениеЗаполнено(Р.ПриборУчета) И Метод <> "" Тогда
			Ост = ОстаннійПоказник(Р.ПриборУчета, Кінець, Метод = "Ввід");
			Р.Попередній1С = Ост.Значення;
			Р.ДатаПопер1С = Ост.Дата;
			Р.Різниця = Р.Показник - Р.Попередній1С;
			Если НЕ Ост.Знайдено Тогда
				Р.Попередження = Истина;
				Статуси.Добавить("У 1С немає жодного введеного показника цього приладу — попередній 0");
			ИначеЕсли Р.Різниця < 0 Тогда
				Р.Попередження = Истина;
				Статуси.Добавить("Показник менший за попередній у 1С (" + Формат(Р.Попередній1С, "ЧГ=0; ЧН=0") + ")");
			КонецЕсли;
		КонецЕсли;

		// --- ЗАХИСТ ВІД ПОВТОРУ ---
		// 1) той самий прилад двічі у файлі — береться лише перший рядок
		КлючП = ?(ЗначениеЗаполнено(Р.ПриборУчета), "П" + Строка(Р.ПриборУчета.УникальныйИдентификатор()),
			"Т" + НормНомер(Р.Особовий) + "|" + НормНомер(Р.НомерЛічильника));
		Перший = Бачені[КлючП];
		Если Перший <> Неопределено Тогда
			Р.Помилка = Истина;
			Статуси.Добавить("ПОВТОР у файлі: цей прилад уже є в рядку " + Перший);
		Иначе
			Бачені.Вставить(КлючП, Р.НомерУФайлі);
		КонецЕсли;
		// 2) прилад уже внесено в 1С за цей місяць (будь-яким документом цього виду)
		Если Метод <> "" Тогда
			Для Каждого Вид Из ВидиДокументів(Метод) Цикл
				Внесено = ВжеВнесено(Вид, Р.ПриборУчета, Початок, Кінець);
				Если ЗначениеЗаполнено(Внесено) Тогда
					Р.Помилка = Истина;
					Статуси.Добавить("ВЖЕ ВНЕСЕНО за місяць: " + Строка(Внесено) + " — повторно не створюється");
				ИначеЕсли ЗначениеЗаполнено(ЛС) Тогда
					// на особовий документ є, але без цього приладу — створиться другий
					Існуючий = ІснуючийДокумент(Вид, ЛС, Початок, Кінець);
					Если ЗначениеЗаполнено(Існуючий) Тогда
						Р.Попередження = Истина;
						Статуси.Добавить("На особовий уже є " + Строка(Існуючий) + " (без цього приладу)");
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Р.Статус = ?(Статуси.Количество() = 0, "OK", СтрСоединить(Статуси, "; "));
		Р.Пометка = НЕ Р.Помилка И НЕ Р.Попередження;
	КонецЦикла;
	ОновитиПідсумок();
КонецПроцедуры

&НаСервере
Процедура ОновитиПідсумок()
	Всього = 0; ОК = 0; Попер = 0; Помил = 0; Без = 0; Створено = 0;
	Для Каждого Р Из Данные Цикл
		Всього = Всього + 1;
		Если ЗначениеЗаполнено(Р.Документ) Тогда
			Створено = Створено + 1;
		ИначеЕсли НЕ Р.ЄПоказник Тогда
			Без = Без + 1;
		ИначеЕсли Р.Помилка Тогда
			Помил = Помил + 1;
		ИначеЕсли Р.Попередження Тогда
			Попер = Попер + 1;
		Иначе
			ОК = ОК + 1;
		КонецЕсли;
	КонецЦикла;
	Підсумок = "Місяць: " + Формат(ДатаПоказань, "ДФ='MMMM yyyy'") + ".  Рядків: " + Всього + ".  Готово до створення: " + ОК
		+ ".  Помилки (виправити): " + Помил + ".  Попередження: " + Попер + ".  Без показника: " + Без
		+ ?(Створено > 0, ".  Створено: " + Створено, "") + ".";
КонецПроцедуры

&НаСервере
Функция ЗнайтиОсобовий(Особовий)
	Н = НормНомер(Особовий);
	Если ПустаяСтрока(Н) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЛС.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.ЛицевыеСчета.СрезПоследних(&НаДату, ЛицевойСчет.Наименование = &Н И Действует = ИСТИНА) КАК ЛС");
	Запрос.УстановитьПараметр("НаДату", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Н", Н);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЛицевойСчет;
	КонецЕсли;
	// із пробілом/без — як записано в 1С
	Если Н <> СокрЛП(Особовий) Тогда
		Запрос.УстановитьПараметр("Н", СокрЛП(Особовий));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЛицевойСчет;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Прилад за заводським № (або найменуванням), встановлений і діючий.
// Повертає Структура(Прилад, Помилка, Попередження).
&НаСервере
Функция ЗнайтиПрилад(Номер, ЛС, НаДату)
	Р = Новый Структура("Прилад,Помилка,Попередження", Неопределено, "", "");
	Н = НормНомер(Номер);
	Будинок = ?(ЗначениеЗаполнено(ЛС), ЛС.Владелец, Неопределено);
	Если НЕ ПустаяСтрока(Н) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	У.ПриборУчета КАК ПриборУчета,
			|	У.ОбъектУстановки КАК ОбъектУстановки
			|ИЗ
			|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату,
			|		ПриборУчета.ЗаводскойНомер = &Н ИЛИ ПриборУчета.Наименование = &Н) КАК У
			|ГДЕ
			|	У.Действует = ИСТИНА");
		Запрос.УстановитьПараметр("НаДату", НаДату);
		Запрос.УстановитьПараметр("Н", Н);
		Т = Запрос.Выполнить().Выгрузить();
		Если Т.Количество() > 0 Тогда
			Для Каждого С Из Т Цикл
				Если ЗначениеЗаполнено(ЛС) И (С.ОбъектУстановки = ЛС ИЛИ С.ОбъектУстановки = Будинок) Тогда
					Р.Прилад = С.ПриборУчета;
					Возврат Р;
				КонецЕсли;
			КонецЦикла;
			Р.Прилад = Т[0].ПриборУчета;
			Если ЗначениеЗаполнено(ЛС) Тогда
				Р.Попередження = "Прилад №" + Номер + " у 1С встановлено на «" + Строка(Т[0].ОбъектУстановки) + "», а не на цьому особовому — перевірте";
			КонецЕсли;
			Возврат Р;
		КонецЕсли;
	КонецЕсли;
	// за номером не знайшли — що стоїть на особовому
	НаОсобовому = ПриладиОсобового(ЛС, НаДату);
	Якщо = "";
	Если НаОсобовому.Количество() > 0 Тогда
		Номери = Новый Массив;
		Для Каждого П Из НаОсобовому Цикл
			Номери.Добавить("№" + ?(ПустаяСтрока(П.ЗаводскойНомер), Строка(П), П.ЗаводскойНомер));
		КонецЦикла;
		Якщо = " На особовому в 1С: " + СтрСоединить(Номери, ", ") + " — якщо прилад замінили, оформіть заміну в 1С.";
	ИначеЕсли ЗначениеЗаполнено(ЛС) Тогда
		Якщо = " На особовому в 1С діючих приладів немає.";
	КонецЕсли;
	Если ПустаяСтрока(Н) Тогда
		Если НаОсобовому.Количество() = 1 Тогда
			Р.Прилад = НаОсобовому[0];
			Р.Попередження = "У файлі немає № лічильника — взято єдиний прилад особового";
		Иначе
			Р.Помилка = "У файлі немає № лічильника." + Якщо;
		КонецЕсли;
	Иначе
		Р.Помилка = "Не знайдено прилад №" + Номер + "." + Якщо;
	КонецЕсли;
	Возврат Р;
КонецФункции

&НаСервере
Функция ПриладиОсобового(ЛС, НаДату)
	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ЛС) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	У.ПриборУчета КАК ПриборУчета
		|ИЗ
		|	РегистрСведений.УстановленныеПриборыУчета.СрезПоследних(&НаДату, ОбъектУстановки = &ЛС) КАК У
		|ГДЕ
		|	У.Действует = ИСТИНА");
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ПриборУчета);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// ОСТАННІЙ ВВЕДЕНИЙ показник приладу на дату (включно з кінцем звітного місяця):
// найсвіжіший запис із регістру «Показання приладів обліку» (туди пишуть «Ввід
// показань приладів (опалення)» і «Ввід показань приладів обліку») та з регістру
// «Акт зняття показань теплолічильника». Для документа «Ввід» спершу береться
// регістр показань (так заповнює кнопка «Заповнити» в самому документі).
// Повертає Структура(Значення, Дата, ВидТарифа, Знайдено).
&НаСервере
Функция ОстаннійПоказник(Прилад, НаДату, СпершуПоказанняПриладів = Ложь)
	Р = Новый Структура("Значення,Дата,ВидТарифа,Знайдено", 0, '00010101', Неопределено, Ложь);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	П.Период КАК Период,
		|	П.Значение КАК Значение,
		|	П.ВидТарифа КАК ВидТарифа,
		|	1 КАК Приоритет
		|ИЗ
		|	РегистрСведений.ПоказанияПриборовУчета.СрезПоследних(&НаДату, ПриборУчета = &Прилад) КАК П
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	А.Период,
		|	А.ПоказаниеТекущее,
		|	А.ВидТарифа,
		|	2
		|ИЗ
		|	РегистрСведений.АктСнятияПоказанийТеплосчетчика.СрезПоследних(&НаДату, ПриборУчета = &Прилад) КАК А");
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Прилад", Прилад);
	Т = Запрос.Выполнить().Выгрузить();
	Если Т.Количество() = 0 Тогда
		Возврат Р;
	КонецЕсли;
	Т.Сортировать("Период Убыв");
	Кращий = Т[0];
	Если СпершуПоказанняПриладів Тогда
		Для Каждого С Из Т Цикл
			Если С.Приоритет = 1 Тогда
				Кращий = С;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Р.Значення = ?(Кращий.Значение = NULL, 0, Кращий.Значение);
	Р.Дата = Кращий.Период;
	Р.ВидТарифа = Кращий.ВидТарифа;
	Р.Знайдено = Истина;
	Возврат Р;
КонецФункции

&НаСервере
Функция ІснуючийДокумент(Вид, ЛС, Початок, Кінець)
	Если Вид = "Акт" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ.АктСнятияПоказанийТеплосчетчика КАК Д
			|ГДЕ Д.ЛицевойСчет = &ЛС И Д.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Д.ПометкаУдаления";
	ИначеЕсли Вид = "Опалення" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ.ВводПоказанийПриборовОтопление КАК Д
			|ГДЕ Д.ЛицевойСчет = &ЛС И Д.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Д.ПометкаУдаления";
	Иначе
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ.ВводПоказанийПриборовУчета.Основная КАК Д
			|ГДЕ Д.ОбъектУстановки = &ЛС И Д.Ссылка.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Д.Ссылка.ПометкаУдаления";
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("Початок", Початок);
	Запрос.УстановитьПараметр("Кінець", Кінець);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

// Документ цього виду за місяць, у якому ВЖЕ Є цей прилад (на будь-якому
// особовому, проведений чи ні; позначені на видалення не рахуються).
&НаСервере
Функция ВжеВнесено(Вид, Прилад, Початок, Кінець)
	Если НЕ ЗначениеЗаполнено(Прилад) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = "Акт" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.АктСнятияПоказанийТеплосчетчика.ПоказанияПриборов КАК Т
			|ГДЕ Т.ПриборУчета = &Прилад И Т.Ссылка.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Т.Ссылка.ПометкаУдаления";
	ИначеЕсли Вид = "Опалення" Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.ВводПоказанийПриборовОтопление.ПриборыУчета КАК Т
			|ГДЕ Т.ПриборУчета = &Прилад И Т.Ссылка.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Т.Ссылка.ПометкаУдаления";
	Иначе
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Документ.ВводПоказанийПриборовУчета.Основная КАК Т
			|ГДЕ Т.ПриборУчета = &Прилад И Т.Ссылка.ПериодНачисления МЕЖДУ &Початок И &Кінець И НЕ Т.Ссылка.ПометкаУдаления";
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Прилад", Прилад);
	Запрос.УстановитьПараметр("Початок", Початок);
	Запрос.УстановитьПараметр("Кінець", Кінець);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

#КонецОбласти

#Область СтворенняДокументів

&НаСервере
Процедура СтворитиДокументиНаСервері()
	Орг = Справочники.Организации.НайтиПоКоду("000000001");
	Групи = Новый Соответствие;     // "Вид|ЛС" → Массив рядків
	Порядок = Новый Массив;
	Взято = Новый Соответствие;     // "Вид|прилад" — щоб один прилад не потрапив двічі
	Початок = НачалоМесяца(ДатаПоказань);
	Кінець = КонецМесяца(ДатаПоказань);
	Для Каждого Р Из Данные Цикл
		Если НЕ Р.Пометка ИЛИ Р.Помилка ИЛИ НЕ Р.ЄПоказник ИЛИ НЕ ЗначениеЗаполнено(Р.ЛицевойСчет) ИЛИ НЕ ЗначениеЗаполнено(Р.ПриборУчета) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вид Из ВидиДокументів(НормМетод(Р.Метод)) Цикл
			КлючП = Вид + "|" + Строка(Р.ПриборУчета.УникальныйИдентификатор());
			Внесено = ВжеВнесено(Вид, Р.ПриборУчета, Початок, Кінець);
			Если Взято[КлючП] <> Неопределено ИЛИ ЗначениеЗаполнено(Внесено) Тогда
				Р.Помилка = Истина;
				Р.Пометка = Ложь;
				Р.Статус = ?(ЗначениеЗаполнено(Внесено), "ВЖЕ ВНЕСЕНО за місяць: " + Строка(Внесено), "ПОВТОР: прилад уже є в рядку " + Взято[КлючП])
					+ " — не створено";
				Продолжить;
			КонецЕсли;
			Взято.Вставить(КлючП, Р.НомерУФайлі);
			Ключ = Вид + "|" + Строка(Р.ЛицевойСчет.УникальныйИдентификатор());
			Если Групи[Ключ] = Неопределено Тогда
				Групи.Вставить(Ключ, Новый Массив);
				Порядок.Добавить(Ключ);
			КонецЕсли;
			Групи[Ключ].Добавить(Р);
		КонецЦикла;
	КонецЦикла;
	Створено = 0; НеПроведено = 0; Помилок = 0;
	Для Каждого Ключ Из Порядок Цикл
		Рядки = Групи[Ключ];
		Вид = Лев(Ключ, СтрНайти(Ключ, "|") - 1);
		ЛС = Рядки[0].ЛицевойСчет;
		Попытка
			Если Вид = "Акт" Тогда
				Док = СтворитиАкт(ЛС, Рядки, Орг);
			ИначеЕсли Вид = "Опалення" Тогда
				Док = СтворитиОпалення(ЛС, Рядки, Орг);
			Иначе
				Док = СтворитиВвід(ЛС, Рядки, Орг);
			КонецЕсли;
			Проведено = Записати(Док);
			Створено = Створено + 1;
			Если НЕ Проведено Тогда
				НеПроведено = НеПроведено + 1;
			КонецЕсли;
			Для Каждого Р Из Рядки Цикл
				Р.Документ = Док.Ссылка;
				Р.Статус = ?(Р.Статус = "OK" ИЛИ СтрНайти(Р.Статус, "Створено") = 1, "Створено", Р.Статус + "; створено")
					+ ": " + Строка(Док.Ссылка) + ?(Проведено, "", " (НЕ проведено)");
				Р.Пометка = Ложь;
			КонецЦикла;
		Исключение
			Помилок = Помилок + 1;
			Опис = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Для Каждого Р Из Рядки Цикл
				Р.Помилка = Истина;
				Р.Статус = "Не вдалося створити " + Вид + ": " + Опис;
			КонецЦикла;
		КонецПопытки;
	КонецЦикла;
	ОновитиПідсумок();
	Підсумок = "Створено документів: " + Створено + ?(НеПроведено > 0, " (не проведено: " + НеПроведено + ")", "")
		+ ?(Помилок > 0, ".  Помилок: " + Помилок, "") + ".  " + Підсумок;
КонецПроцедуры

&НаСервере
Функция Записати(Док)
	Если НЕ Проводити Тогда
		Док.Записать(РежимЗаписиДокумента.Запись);
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Возврат Истина;
	Исключение
		Док.Записать(РежимЗаписиДокумента.Запись);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Функция Коментар(Рядки)
	Хто = Новый Массив;
	Для Каждого Р Из Рядки Цикл
		Т = СокрЛП(Р.Хто) + ?(ЗначениеЗаполнено(Р.ДатаЗняття), " " + Формат(Р.ДатаЗняття, "ДФ=dd.MM.yyyy"), "");
		Если НЕ ПустаяСтрока(Т) И Хто.Найти(Т) = Неопределено Тогда
			Хто.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Возврат "Теплооблік" + ?(Хто.Количество() > 0, ": " + СтрСоединить(Хто, ", "), "");
КонецФункции

// Акт зняття показань теплолічильника: один на особовий, усі його прилади,
// з водою, наробітком, простоєм, температурами, витратою й потужністю.
&НаСервере
Функция СтворитиАкт(ЛС, Рядки, Орг)
	Док = Документы.АктСнятияПоказанийТеплосчетчика.СоздатьДокумент();
	Док.Дата = КонецМесяца(ДатаПоказань);
	Док.ПериодНачисления = НачалоМесяца(ДатаПоказань);
	Док.Организация = Орг;
	Док.ЛицевойСчет = ЛС;
	Док.Здание = ЛС.Владелец;
	Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Док.Коментарий = Коментар(Рядки);
	Для Каждого Р Из Рядки Цикл
		Д = РозібратиДод(Р.Дод);
		// параметри вузла в шапці — з першого приладу, де вони є
		Если Док.ТемператураПодача = 0 И Д["ТВхід"] <> Неопределено Тогда Док.ТемператураПодача = Д["ТВхід"]; КонецЕсли;
		Если Док.ТемператураОбратка = 0 И Д["ТВихід"] <> Неопределено Тогда Док.ТемператураОбратка = Д["ТВихід"]; КонецЕсли;
		Если Док.РасходТеплоносителя = 0 И Д["Витрата"] <> Неопределено Тогда Док.РасходТеплоносителя = Д["Витрата"]; КонецЕсли;
		Если Док.МоментальнаяМощность = 0 И Д["Потужність"] <> Неопределено Тогда Док.МоментальнаяМощность = Д["Потужність"]; КонецЕсли;

		П = РасчетУслугПоТЕиГВ.ПолучитьПоказанияПрибораУчетаПоТЕ(Р.ПриборУчета, КонецМесяца(ДатаПоказань));
		НС = Док.ПоказанияПриборов.Добавить();
		НС.ЛицевойСчет = ЛС;
		НС.ПриборУчета = Р.ПриборУчета;
		НС.ВидТарифа = Перечисления.ВидыТарифов.Общий;
		НС.ЕдиницаИзмерения = Р.ПриборУчета.ЕдиницаИзмерения;
		НС.Коэффициент = Р.ПриборУчета.Коэффициент;
		НС.ПоказаниеПредыдущее = ОстаннійПоказник(Р.ПриборУчета, КонецМесяца(ДатаПоказань)).Значення;
		НС.ПоказаниеТекущее = Р.Показник;
		НС.РазницаПоказания = НС.ПоказаниеТекущее - НС.ПоказаниеПредыдущее;
		// додаткові лічильники приладу — лише якщо їх зняли
		Если Д["Наробіток"] <> Неопределено Тогда
			НС.НаработкаТеплосчетчикаПредыдущее = ЗначАбо(П, "ЧасыНаработкиПредыдущие", Д["НаробітокП"]);
			НС.НаработкаТеплосчетчикаТекущее = Д["Наробіток"];
			НС.РазницаЧасы = НС.НаработкаТеплосчетчикаТекущее - НС.НаработкаТеплосчетчикаПредыдущее;
		КонецЕсли;
		Если Д["Вода"] <> Неопределено Тогда
			НС.ОбъемВодыПоТеплоСчетчикуПредыдущее = ЗначАбо(П, "ОбъемВодыПоТеплоСчетчикуПредыдущие", Д["ВодаП"]);
			НС.ОбъемВодыПоТеплоСчетчикуТекущее = Д["Вода"];
			НС.РазницаВода = НС.ОбъемВодыПоТеплоСчетчикуТекущее - НС.ОбъемВодыПоТеплоСчетчикуПредыдущее;
		КонецЕсли;
		Если Д["Простій"] <> Неопределено Тогда
			НС.ЧасыПростояПредыдущие = ЗначАбо(П, "ЧасыПростоя", Д["ПростійП"]);
			НС.ЧасыПростояТекущие = Д["Простій"];
			НС.ЧасыПростояРазница = НС.ЧасыПростояТекущие - НС.ЧасыПростояПредыдущие;
		КонецЕсли;
	КонецЦикла;
	Возврат Док;
КонецФункции

// Ввід показань приладів (опалення): один на особовий.
&НаСервере
Функция СтворитиОпалення(ЛС, Рядки, Орг)
	Док = Документы.ВводПоказанийПриборовОтопление.СоздатьДокумент();
	Док.Дата = КонецМесяца(ДатаПоказань);
	Док.ПериодНачисления = НачалоМесяца(ДатаПоказань);
	Док.Организация = Орг;
	Док.ЛицевойСчет = ЛС;
	Док.Здание = ЛС.Владелец;
	Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Док.Услуга = ПослугаОпалення(ЛС);
	Док.Комментарий = Коментар(Рядки);
	Для Каждого Р Из Рядки Цикл
		НС = Док.ПриборыУчета.Добавить();
		НС.ПриборУчета = Р.ПриборУчета;
		НС.ВидТарифа = Перечисления.ВидыТарифов.Общий;
		НС.Источник = Перечисления.ИсточникиПоказаний.Оператор;
		НС.Услуга = Док.Услуга;
		НС.ПредыдущиеПоказания = ОстаннійПоказник(Р.ПриборУчета, КонецМесяца(ДатаПоказань)).Значення;
		НС.ТекущиеПоказания = Р.Показник;
		НС.КвоКубов = НС.ТекущиеПоказания - НС.ПредыдущиеПоказания;
	КонецЦикла;
	Возврат Док;
КонецФункции

// Ввід показань приладів обліку: один на особовий. Рядок заповнюється так само,
// як кнопка «Заповнити» у формі документа; витрату рахує ПриборыУчета.ПолучитьРасход.
&НаСервере
Функция СтворитиВвід(ЛС, Рядки, Орг)
	Док = Документы.ВводПоказанийПриборовУчета.СоздатьДокумент();
	Док.Дата = КонецМесяца(ДатаПоказань);
	Док.ПериодНачисления = НачалоМесяца(ДатаПоказань);
	Док.Организация = Орг;
	Док.Здание = ЛС.Владелец;
	Док.Комментарий = Коментар(Рядки);
	Власник = ВідповідальнийВласник(ЛС, КонецМесяца(ДатаПоказань));
	Для Каждого Р Из Рядки Цикл
		Ост = ОстаннійПоказник(Р.ПриборУчета, КонецМесяца(ДатаПоказань), Истина);
		Попередній = Ост.Значення;
		ВидТарифа = Ост.ВидТарифа;
		НС = Док.Основная.Добавить();
		НС.ОбъектУстановки = ЛС;
		НС.ПриборУчета = Р.ПриборУчета;
		НС.Услуга = Р.ПриборУчета.Услуга;
		НС.ВидТарифа = ?(ЗначениеЗаполнено(ВидТарифа), ВидТарифа, Перечисления.ВидыТарифов.Общий);
		НС.Коэффициент = Р.ПриборУчета.Коэффициент;
		НС.ОбъектЛицевогоСчета = ЛС.ОбъектЛицевогоСчета;
		НС.ОтветственныйВладелец = Власник;
		НС.ПоказаниеПредыдущее = Попередній;
		НС.Показание = Р.Показник;
		НС.ДатаПоказаний = ?(ЗначениеЗаполнено(Р.ДатаЗняття), Р.ДатаЗняття, КонецМесяца(ДатаПоказань));
		НС.Источник = Перечисления.ИсточникиПоказаний.Оператор;
		Розр = Справочники.ПриборыУчета.ПолучитьРасход(Новый Структура("ПриборУчета,ПредыдущееПоказание,ТекущееПоказание",
			НС.ПриборУчета, НС.ПоказаниеПредыдущее, НС.Показание));
		Если ЗначениеЗаполнено(Розр.ТекстОшибки) Тогда
			ВызватьИсключение Розр.ТекстОшибки;
		КонецЕсли;
		НС.Разница = Розр.РасходПоПриборуУчета;
		НС.ПереходЧерезНоль = Розр.ЕстьПереходПоказанийЧерезНоль;
		НС.РасходЗаПериодРасчета = Розр.РасходЗаПериодРасчета;
		Если НЕ ЗначениеЗаполнено(Док.Услуга) Тогда
			Док.Услуга = НС.Услуга;
		КонецЕсли;
	КонецЦикла;
	Возврат Док;
КонецФункции

&НаСервере
Функция ПослугаОпалення(ЛС)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Н.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.НазначенныеУслуги.СрезПоследних(&НаДату, ЛицевойСчет = &ЛС И Услуга.ВидУслуги = &Вид) КАК Н");
	Запрос.УстановитьПараметр("НаДату", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыУслуг.Отопление);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Услуга, Неопределено);
КонецФункции

&НаСервере
Функция ВідповідальнийВласник(ЛС, НаДату)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	В.ОтветственныйВладелец КАК ОтветственныйВладелец
		|ИЗ
		|	РегистрСведений.ОтветственныйВладелецЛицевогоСчета.СрезПоследних(&НаДату, ЛицевойСчет = &ЛС) КАК В");
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ОтветственныйВладелец, Неопределено);
КонецФункции

#КонецОбласти

#Область Допоміжні

&НаСервере
Процедура НалаштуватиОформлення()
	ДодатиОформлення("Данные.Помилка", WebЦвета.Красный, "ДанныеСтатус,ДанныеОсобовий,ДанныеНомерЛічильника");
	ДодатиОформлення("Данные.Попередження", WebЦвета.ТемноОранжевый, "ДанныеСтатус");
КонецПроцедуры

&НаСервере
Процедура ДодатиОформлення(ПолеУмови, Колір, Поля)
	Эл = УсловноеОформление.Элементы.Добавить();
	Отбор = Эл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеУмови);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Эл.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Колір);
	Для Каждого Ім Из СтрРазделить(Поля, ",") Цикл
		П = Эл.Поля.Элементы.Добавить();
		П.Поле = Новый ПолеКомпоновкиДанных(Ім);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗастосуватиВідбір()
	Если ЛишеПроблемні Тогда
		Элементы.Данные.ОтборСтрок = Новый ФиксированнаяСтруктура("Помилка", Истина);
	Иначе
		Элементы.Данные.ОтборСтрок = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НормМетод(Метод)
	М = НРег(СтрЗаменить(СтрЗаменить(СокрЛП(Метод), " ", ""), Символы.НПП, ""));
	М = СтрЗаменить(М, "ввод", "ввід");
	Если М = "акт" Тогда
		Возврат "Акт";
	ИначеЕсли М = "опалення" ИЛИ М = "отопление" Тогда
		Возврат "Опалення";
	ИначеЕсли М = "ввід" Тогда
		Возврат "Ввід";
	ИначеЕсли М = "акт+ввід" ИЛИ М = "ввід+акт" Тогда
		Возврат "Акт+Ввід";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ВидиДокументів(Метод)
	Р = Новый Массив;
	Если Метод = "Акт" ИЛИ Метод = "Акт+Ввід" Тогда
		Р.Добавить("Акт");
	КонецЕсли;
	Если Метод = "Опалення" Тогда
		Р.Добавить("Опалення");
	КонецЕсли;
	Если Метод = "Ввід" ИЛИ Метод = "Акт+Ввід" Тогда
		Р.Добавить("Ввід");
	КонецЕсли;
	Возврат Р;
КонецФункции

&НаСервереБезКонтекста
Функция НормНомер(Значення)
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(Значення), Символы.НПП, ""), " ", "");
КонецФункции

&НаСервереБезКонтекста
Функция Комірка(Рядок, Індекс)
	Если Індекс < 0 ИЛИ Індекс >= Рядок.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Рядок[Індекс]);
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоЗРядка(Текст)
	С = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), Символы.НПП, ""), ",", ".");
	Если ПустаяСтрока(С) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(С);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// дд.мм.рррр або рррр-мм-дд
&НаСервереБезКонтекста
Функция ДатаЗРядка(Текст)
	С = СокрЛП(Текст);
	Попытка
		Если СтрДлина(С) >= 10 И Сред(С, 3, 1) = "." Тогда
			Возврат Дата(Число(Сред(С, 7, 4)), Число(Сред(С, 4, 2)), Число(Лев(С, 2)));
		ИначеЕсли СтрДлина(С) >= 10 И Сред(С, 5, 1) = "-" Тогда
			Возврат Дата(Число(Лев(С, 4)), Число(Сред(С, 6, 2)), Число(Сред(С, 9, 2)));
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат '00010101';
КонецФункции

&НаСервереБезКонтекста
Функция РозібратиДод(Дод)
	Р = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить(Дод, ";", Ложь) Цикл
		Поз = СтрНайти(Пара, "=");
		Если Поз > 0 Тогда
			Р.Вставить(Лев(Пара, Поз - 1), ЧислоЗРядка(Сред(Пара, Поз + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// значення зі структури, яку повертає ПолучитьПоказанияПрибораУчетаПоТЕ (може бути порожньою)
&НаСервереБезКонтекста
Функция ЧислоЗі(Структура, Ключ)
	Значення = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ, Значення) И ТипЗнч(Значення) = Тип("Число") Тогда
		Возврат Значення;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервереБезКонтекста
Функция ЗначАбо(Структура, Ключ, Запасне)
	Значення = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Ключ, Значення) И ТипЗнч(Значення) = Тип("Число") Тогда
		Возврат Значення;
	КонецЕсли;
